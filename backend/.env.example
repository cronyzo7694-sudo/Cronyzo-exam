# ─────────────────────────────────────────────────────────────────────────────
# Cronyzo — backend environment
#
# Nothing here is required to run locally: sensible development defaults are
# built in. Copy to `.env` (python-dotenv loads it automatically) and fill in
# only the sections you actually need.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too
FLASK_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Default: SQLite file at backend/cronyzo.db
# Neon (later): paste the pooled connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/cronyzo?sslmode=require
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/cronyzo?sslmode=require

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma separated. Preview hosts (*.e2b.app) are always allowed.
# CORS_ORIGINS=https://cronyzo.app,https://www.cronyzo.app

# ── Google / Firebase sign-in ────────────────────────────────────────────
# With neither set, the Google button works in TESTING MODE: it signs the
# visitor in to a demo Google account so the flow is exercisable end to end.
#
# Option A — Firebase (recommended). ID tokens are verified against Google's
# public certificates; no client secret needed on the server.
# FIREBASE_PROJECT_ID=your-project-id
#
# Option B — plain Google Identity Services.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Telegram (support messages reach your phone) ─────────────────────────
# 1. Talk to @BotFather → /newbot → copy the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
# 3. Paste both here and restart. Admin → Site content → Integrations → Send test.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234567890
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_PUBLIC_HANDLE=@cronyzohelp

# ── File storage (Cloudinary — later) ────────────────────────────────────
# Unset: uploads land in backend/uploads and are served by /api/files/…
# Set:   every new upload goes to Cloudinary instead (pip install cloudinary)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Uploads ──────────────────────────────────────────────────────────────
# MAX_CONTENT_LENGTH=52428800
# UPLOAD_FOLDER=uploads

# ── Feature flags (all optional) ─────────────────────────────────────────
# ENABLE_GUEST_ACCESS=true
# ENABLE_EMAIL_PASSWORD_LOGIN=true
# ENABLE_PHONE_OTP=false

# ── Boot control ─────────────────────────────────────────────────────────
# CRONYZO_SKIP_SEED=false
# CRONYZO_SKIP_CREATE_ALL=false
