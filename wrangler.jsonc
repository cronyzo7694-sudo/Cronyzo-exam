// Cloudflare Worker (static assets) — serves the built Vite app.
//
// The Worker connected to this repo builds at the repo root, so:
//   1. `npm ci && npm run build` runs in ./frontend  (Build command)
//   2. `npx wrangler deploy` uploads ./frontend/dist (Deploy command)
//
// `single-page-application` is what makes /shop, /admin/sellers etc. deep-link
// correctly instead of 404-ing on refresh — the same job _redirects does on
// Cloudflare Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronyzo-exam",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-traverse-html-extension"
  }
}
